      }
    ]
  },
  "mixins": [
    "xenon.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*",
    "fabric-language-kotlin": "*",
    "yet_another_config_lib_v3": ">=3.9.7+26.3-fabric"
